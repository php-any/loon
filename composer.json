{
    "name": "php-any/loom",
    "description": "A general-purpose admin application built with Origami, with its own product website.",
    "type": "project",
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "build/loom serve"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "build/loom tests/run.php"
        ],
        "loom": [
            "Composer\\Config::disableProcessTimeout",
            "build/loom"
        ],
        "doctor": "build/loom doctor",
        "build": "pwsh -NoProfile -File scripts/build.ps1",
        "format:install": "@composer --working-dir=scripts/php-cs-fixer install --no-interaction",
        "format": "@php scripts/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=no --sequential",
        "format:check": "@php scripts/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=no --sequential --dry-run --diff"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Generated\\Grpc\\": "generated/grpc/"
        }
    }
}
