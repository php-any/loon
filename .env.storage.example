# 仅作示例。复制到 .env 供 PHP 加载，并向 Compose 传入 --env-file .env。
# 根目录 .env 中的值会覆盖进程环境变量。
LOOM_DATABASE=mysql:host=127.0.0.1;port=13306;dbname=loom;charset=utf8mb4
LOOM_MYSQL_USER=loom
LOOM_MYSQL_PASSWORD=replace-with-your-local-mysql-password
LOOM_REDIS_PASSWORD=replace-with-your-local-redis-password
LOOM_REDIS_URL=redis://:replace-with-your-local-redis-password@127.0.0.1:16379/0
LOOM_REDIS_PREFIX=loom:
