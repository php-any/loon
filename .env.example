# 由 PHP 加载。此文件中的值会覆盖进程环境变量。
# 值按字面量处理；包含空白或 # 时需加引号。不支持插值。
# 在进程环境中设置 LOOM_ENV_FILE 可使用其他环境文件。
LOOM_ADDRESS=127.0.0.1:18087
LOOM_DATABASE="mysql:host=127.0.0.1;port=3306;dbname=loom;charset=utf8mb4"
# 与 Laravel 相同的连接变量。LOOM_DATABASE 已设置时，主机、端口和库名以它为准。
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=loom
# DB_USERNAME=loom
# DB_PASSWORD=
LOOM_MYSQL_USER=loom
LOOM_MYSQL_PASSWORD=replace-with-your-local-mysql-password
LOOM_REDIS_URL=redis://127.0.0.1:6379/0
LOOM_REDIS_PREFIX=loom:
